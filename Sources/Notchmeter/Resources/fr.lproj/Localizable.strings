"%1$ld of %2$ld done" = "%1$ld sur %2$ld faites";
"Task list" = "Liste de tâches";
"Untitled task" = "Tâche sans titre";
"Claude Code's task list for this session; click to show it" = "La liste de tâches de Claude Code pour cette session ; cliquez pour l'afficher";
"Claude Code's task list for this session" = "La liste de tâches de Claude Code pour cette session";
"Subagent %ld" = "Sous-agent %ld";
"How full this session's context window is, from its status line" = "Le remplissage de la fenêtre de contexte de cette session, d'après sa ligne d'état";
"In progress" = "En cours";
