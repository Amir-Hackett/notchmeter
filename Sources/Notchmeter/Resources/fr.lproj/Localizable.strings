"How long since this session last did anything" = "Depuis combien de temps cette session n'a rien fait";
"How long this turn has run" = "Depuis combien de temps ce tour dure";
"The assistant running this session" = "L'assistant qui exécute cette session";
"Subagents" = "Sous-agents";
